[importlinter]
root_packages =
    skillhub

[importlinter:contract:core-independence]
name = Core does not import web, llm or composition roots
type = forbidden
source_modules =
    skillhub.core
forbidden_modules =
    skillhub.web
    skillhub.llm
    skillhub.usage
    skillhub.app_factory
    skillhub.main

[importlinter:contract:llm-independence]
name = LLM does not import web or composition roots
type = forbidden
source_modules =
    skillhub.llm
forbidden_modules =
    skillhub.web
    skillhub.app_factory
    skillhub.main

[importlinter:contract:protocol-independence]
name = Protocol does not import web, llm, classifier, assistant, docx_export or composition
type = forbidden
source_modules =
    skillhub.protocol
forbidden_modules =
    skillhub.web
    skillhub.llm
    skillhub.classifier
    skillhub.assistant
    skillhub.docx_export
    skillhub.app_factory
    skillhub.main

[importlinter:contract:usage-independence]
name = Usage does not import web, llm, composition or neighboring packages
type = forbidden
source_modules =
    skillhub.usage
forbidden_modules =
    skillhub.web
    skillhub.llm
    skillhub.app_factory
    skillhub.main
    skillhub.assistant
    skillhub.classifier
    skillhub.protocol
    skillhub.docx_export

[importlinter:contract:docx-export-isolation]
name = docx_export imports only the public Protocol model
type = forbidden
source_modules =
    skillhub.docx_export
forbidden_modules =
    skillhub.protocol._parser
    skillhub.protocol._draft
    skillhub.protocol._renderer
    skillhub.web
    skillhub.registry
    skillhub.llm
    skillhub.classifier
    skillhub.assistant
    skillhub.app_factory
    skillhub.main
