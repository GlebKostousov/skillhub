# Именованный шаблон переменных процесса SkillHub.
# Приложение файлы `.env` не читает: значения задаются в окружении процесса.

# Ключ DeepSeek. Без него приложение стартует, генерация недоступна.
# Со страницы «Настройки» и из JSON ключ не задаётся.
DEEPSEEK_API_KEY=

# Режим окружения: development | test | production
# SKILLHUB_ENVIRONMENT=development

# Путь к файлу журнала расходов
# SKILLHUB_USAGE_PATH=usage.sqlite3

# Посевной дневной потолок в нано-USD: значение по умолчанию, пока нет
# действительного наложения. Живой потолок — daily_budget_nanos.
# Повреждённое наложение возвращает посев. Если переменная не задана, посева нет.
# SKILLHUB_DAILY_BUDGET_NANOS=

# Файл наложения всегда называется runtime-overlay.json и лежит в рабочем
# каталоге процесса. URL поставщика — константа шлюза. Страница и окружение
# эти значения не принимают; в шаблон они не входят.
